# ─── NAAMI environment variables ──────────────────────────────────────────────
# Copy to `.env.local` for development. On the VPS, set these in the prod env file.

# Email granted super_admin role (lowercased on read)
SUPER_ADMIN_EMAIL=you@example.com

# ─── Site identity ─────────────────────────────────────────────────────────────
# Canonical site URL — used for sitemap.xml, the abandoned-cart email link, and
# other absolute-URL generation. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://naami.example.com
# Contact links shown in the footer / cart page. Optional — omit to hide them.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Auth (JWT sessions) ────────────────────────────────────────────────────────
# Signs/verifies the `naami_session` cookie (jose). Must be a long random string
# (≥32 chars). Generate with: openssl rand -base64 32
JWT_SECRET=CHANGEME-long-random-string

# ─── Database (self-hosted PostgreSQL) ────────────────────────────────────────
# Dev:  points at the local Docker Postgres (see docker-compose.yml)
# Prod: points at PostgreSQL running on the same OVH VPS (localhost)
# Both are non-SSL, so DATABASE_SSL stays false. Set it to "true" ONLY if you
# ever connect to a remote DB that mandates TLS.
DATABASE_URL=postgres://naami:CHANGEME@localhost:5432/naami
DATABASE_SSL=false
DB_POOL_MAX=10

# ─── Read replica (read/write splitting — optional) ───────────────────────────
# When set, pure reads go to the replica and writes/transactions stay on the
# primary (DATABASE_URL). Leave unset for a single-node setup — reads fall back
# to the primary automatically.
# DATABASE_REPLICA_URL=postgres://naami:CHANGEME@replica-host:5432/naami

# ─── Upstash Redis (external — cache, rate limiting, OTP) ──────────────────────
# The app fails open if these are missing or the free-tier quota is hit.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# ─── PII field encryption (optional) ──────────────────────────────────────────
# Base64-encoded 32-byte key for AES-256-GCM encryption of stored PII (shipping
# phone/address). Generate with: openssl rand -base64 32
# If unset, PII is stored in plaintext (dev-friendly; set it in production).
# ENCRYPTION_KEY=

# ─── Async jobs worker ────────────────────────────────────────────────────────
# Shared secret the worker uses to call the internal /api/internal/process-jobs
# endpoint. Required for the worker (see scripts/jobs-worker.mjs) to run.
JOBS_WORKER_SECRET=CHANGEME-long-random-string

# Hours of cart inactivity before an abandoned-cart reminder email is enqueued.
# Optional — defaults to 6.
# ABANDONED_CART_REMINDER_HOURS=6

# ─── Transactional email (Resend) ──────────────────────────────────────────────
# Order confirmations, abandoned-cart reminders, status updates, invoices,
# low-stock alerts. Get an API key at https://resend.com.
RESEND_API_KEY=re_CHANGEME
RESEND_FROM="NAAMI <orders@example.com>"
# Address that receives low-stock / admin notification emails. Falls back to
# GMAIL_USER below if unset.
ADMIN_EMAIL=you@example.com

# ─── OTP email (Gmail SMTP via Nodemailer) ─────────────────────────────────────
# Separate channel used only for signup/password-reset OTP codes.
# GMAIL_PASS must be a Gmail *App Password*, not your normal account password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_PASS=CHANGEME-app-password

# ─── Payments (Razorpay) ────────────────────────────────────────────────────────
# From your Razorpay dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=rzp_live_CHANGEME
RAZORPAY_KEY_SECRET=CHANGEME
# Same key ID, exposed to the client-side checkout widget.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_CHANGEME

# ─── Logging ──────────────────────────────────────────────────────────────────
# Minimum level to emit: debug | info | warn | error. Defaults to debug in dev,
# info in production.
# LOG_LEVEL=info

# ─── Meta Pixel (client-side, optional) ───────────────────────────────────────
# Facebook/Instagram ads pixel ID. If unset, MetaPixel renders nothing.
NEXT_PUBLIC_META_PIXEL_ID=

